/* 3. Estilo para la etiqueta body */
body {
  font-family: Arial, sans-serif;
  font-size: 16px;
  margin: 0;
  padding: 0;
  background-color: #f4f4f4;
  color: #222222; /* Alto contraste con el fondo */
}

/* 4. Estilo para la etiqueta header */
header {
  background-color: #1a365d;
}

/* 5. Estilo para la etiqueta nav */
nav {
  background-color: #2b6cb0;
}

/* 6. Estilo para la etiqueta main */
main {
  background-color: #ffffff;
  font-size: 18px;
  padding: 20px;
}

/* 7. Estilo para la etiqueta footer */
footer {
  background-color: #1a365d;
  color: #ffffff;
}

/* 8. Estilo para la etiqueta li */
li {
  display: inline-block;
  width: 120px;
}

/* 9. Estilo para la etiqueta h1 */
h1 {
  text-align: center;
  font-family: 'Georgia', serif;
  color: #ffffff;
}

/* 10. Estilo para la etiqueta p */
p {
  line-height: 1.6;
}
