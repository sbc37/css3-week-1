/* ===========================================
   Hoja de estilo única para las tres páginas
   CSS Week 1 - HW1
   =========================================== */

/* ---- Paso 3: body (font-family y font-size) ---- */
body {
    font-family: Verdana, Geneva, sans-serif;
    font-size: 16px;
    margin: 0;
}

/* ---- Paso 4: header (background-color) ---- */
header {
    background-color: #1B3A57;
    color: #FFFFFF;
    padding: 20px;
}

/* ---- Paso 5: nav (background-color) ---- */
nav {
    background-color: #2E5C8A;
    padding: 10px;
}

/* ---- Paso 6: main (background-color y font-size) ---- */
main {
    background-color: #F5F5F5;
    font-size: 18px;
    padding: 25px;
}

/* ---- Paso 7: footer (background-color) ---- */
footer {
    background-color: #1B3A57;
    color: #FFFFFF;
    padding: 15px;
    text-align: center;
}

/* ---- Paso 8: li (display y width) ---- */
li {
    display: inline-block;
    width: 150px;
}

/* ---- Paso 9: h1 (text-align, font-family y color) ---- */
h1 {
    text-align: center;
    font-family: Georgia, "Times New Roman", serif;
    color: #FFFFFF;
}

/* ---- Paso 10: p (line-height) ---- */
p {
    line-height: 1.6;
}

/* ===========================================
   Estilos adicionales (opcionales)
   =========================================== */

nav ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    text-align: center;
}

nav a {
    color: #FFFFFF;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

h2 {
    color: #1B3A57;
}

img {
    max-width: 100%;
    height: auto;
}
